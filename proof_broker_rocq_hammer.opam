# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Proof Broker Rocq plugin — coq-hammer HOL closer opt-in"
description:
  "Optional opt-in extension to proof_broker_rocq: registers coq-hammer's hauto as the HOL/FOL closer (Ltac proof_broker_hol_closer). Mirrors lean-bridge/ProofBrokerMathlib's role on the Lean side (which registers Mathlib's aesop). With this package imported, the proof_broker tactic can close Vampire-minted Tier-3 HOL certs; without it, the core plugin's default Ltac fails with a directive to install/import this package (audit H1: HOL goals stay OPEN until a sound closer fires)."
depends: [
  "ocaml" {>= "5.0"}
  "dune" {>= "3.21" & < "3.24"}
  "proof_broker_rocq"
  "rocq-runtime" {>= "9.0" & < "9.2"}
  "coq-core" {>= "9.0" & < "9.2"}
  "coq-stdlib" {>= "9.0" & < "9.2"}
  "coq-hammer-tactics" {>= "1.3"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
x-maintenance-intent: ["(latest)"]
