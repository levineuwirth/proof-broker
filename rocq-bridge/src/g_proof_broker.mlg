DECLARE PLUGIN "proof_broker_rocq.plugin"

{
open Ltac_plugin
open Stdarg
}

(* [proof_broker_test [adapters]?] — debug form: dispatch + verify,
   then print summary; does NOT close. Useful for inspecting what
   the broker minted without trusting the closer. *)
TACTIC EXTEND ProofBrokerTest
| [ "proof_broker_test" ] -> { Pb_rocq_main.run_test None }
| [ "proof_broker_test" "[" ne_ident_list_sep(names, ",") "]" ] ->
    { Pb_rocq_main.run_test (Some names) }
END

(* [proof_broker [adapters]?] — closing form. Bare invocation uses
   default manifests sorted by tier descending; bracketed list
   respects the user's order verbatim (filter + priority lever),
   matching Lean's [proof_broker [cvc5, z3]] discipline. *)
TACTIC EXTEND ProofBroker
| [ "proof_broker" ] -> { Pb_rocq_main.run_close None }
| [ "proof_broker" "[" ne_ident_list_sep(names, ",") "]" ] ->
    { Pb_rocq_main.run_close (Some names) }
END

(* [proof_broker_walker [adapters]?] — walker-STRICT closing form.
   Like [proof_broker] but closes ONLY via the Alethe walker on the
   live-dispatched cert, with no [lia] fallback. End-to-end guard for
   the production cvc5 -> Tier-3 cert -> walker -> kernel path; the
   plain [proof_broker]'s fallback otherwise masks a walker regression
   along that live path. Test-only. *)
TACTIC EXTEND ProofBrokerWalker
| [ "proof_broker_walker" ] -> { Pb_rocq_main.run_close_walker None }
| [ "proof_broker_walker" "[" ne_ident_list_sep(names, ",") "]" ] ->
    { Pb_rocq_main.run_close_walker (Some names) }
END

(* [proof_broker_verbose [adapters]?] — verbose form mirroring
   Lean's [proof_broker?]. Prints multi-line extraction-path
   summary (IR shape, attempts, cert, verify) before closing.
   Rocq doesn't accept ? in tactic identifiers, so the suffix is
   [_verbose] rather than [?]. *)
TACTIC EXTEND ProofBrokerVerbose
| [ "proof_broker_verbose" ] -> { Pb_rocq_main.run_verbose None }
| [ "proof_broker_verbose" "[" ne_ident_list_sep(names, ",") "]" ] ->
    { Pb_rocq_main.run_verbose (Some names) }
END

(* [proof_broker_term [adapters]?] — term-mode closer. Builds an
   actual Rocq proof term from the cert's Farkas witness instead of
   delegating to lia. Restricts dispatch to z3 by default (only
   adapter that mints Tier 1 farkas certs natively, which is what
   the term builder consumes). Out-of-scope cases (non-Le hypotheses,
   higher arities) raise; the user explicitly opted into term mode
   by typing [proof_broker_term] over plain [proof_broker]. *)
TACTIC EXTEND ProofBrokerTerm
| [ "proof_broker_term" ] -> { Pb_rocq_main.run_close_term None }
| [ "proof_broker_term" "[" ne_ident_list_sep(names, ",") "]" ] ->
    { Pb_rocq_main.run_close_term (Some names) }
END

(* TEST-ONLY tactic for the LLM-replay closer (roadmap §Phase 3
   #3, Rocq parity M2). Drives the exact [Llm_replay.replay_script]
   path [close_or_fail] takes for a Tier-3 [Tier3_replay_deferred]
   cert, but feeds the string literal directly as the cert payload
   so CI can exercise the audit-H1 contract without a live LLM
   endpoint. Mirror of [llm_replay_test] in
   lean-bridge/ProofBroker/Tactic.lean. *)
TACTIC EXTEND ProofBrokerLlmReplayTest
| [ "llm_replay_test" string(s) ] -> { Llm_replay.replay_script s }
END

(* TEST-ONLY tactic for the LLM-assisted Tier-3 reconstruction
   fallback (roadmap §Phase 3 #4, Rocq parity M3). The live SDK
   path ([Llm_reconstruct.translate]) only runs when an endpoint
   is configured — for CI we skip the translation call and feed
   the candidate script directly into the {e same} closer the
   production path invokes after a successful translation
   ([Pb_rocq_main.replay_reconstructed_script]). This pins the
   integration: a translated script flows through
   [Llm_replay.replay_script] (kernel replay + axiom-footprint
   gate), the same audit-H1 contract [llm_replay_test] exercises
   for primary LLM certs. First argument is the trace format of
   the (notionally un-replayable) source cert — surfaces in the
   audit feedback line. Mirror of [llm_reconstruct_test] in
   lean-bridge/Test/Tactic.lean. *)
TACTIC EXTEND ProofBrokerLlmReconstructTest
| [ "llm_reconstruct_test" string(fmt) string(s) ] -> {
    Pb_rocq_main.replay_reconstructed_script fmt s
  }
END

(* TEST-ONLY tactic for the Rocq-side Alethe walker port. Parses
   the string literal as an alethe-2024 trace, walks the proof
   into a Coq kernel term, and assigns the goal — same
   CI-stable pattern as [llm_replay_test], parallel to Lean's
   [alethe_walker_test] in lean-bridge/ProofBroker/Tactic.lean.
   R-2 scope: clausal rules (assume / or / false / resolution).
   Subsequent PRs (R-3 onward) extend rule coverage; R-9 wires
   the same walker logic into [close_or_fail] under
   [tclORELSE → lia] for production. *)
TACTIC EXTEND ProofBrokerAletheWalkerTest
| [ "alethe_walker_test" string(s) ] -> { Alethe_walker.walker_test s }
| [ "pb_spec_gate_test" ident(mode) ident(kind) ] ->
  { Pb_rocq_main.run_spec_gate_test
      (Names.Id.to_string mode) (Names.Id.to_string kind) }
END
