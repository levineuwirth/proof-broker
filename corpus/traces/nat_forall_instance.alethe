(
(assume a0 (! (<= 0 n) :named @p_1))
(assume a1 (! (not (! (<= 1 (! (+ n 1) :named @p_2)) :named @p_3)) :named @p_4))
(step t0 (cl (not (! (= @p_1 (! (>= n 0) :named @p_5)) :named @p_12)) (not @p_1) @p_5) :rule equiv_pos2)
(step t1 (cl @p_12) :rule hole :args ("TRUST_THEORY_REWRITE" @p_12 3 7))
(step t2 (cl @p_5) :rule resolution :premises (t0 t1 a0))
(step t3 (cl (not (! (= @p_4 (! (not @p_5) :named @p_6)) :named @p_7)) (not @p_4) @p_6) :rule equiv_pos2)
(step t4 (cl (= 1 1)) :rule refl)
(step t5 (cl (! (= @p_2 (! (+ 1 n) :named @p_8)) :named @p_11)) :rule hole :args ("TRUST_THEORY_REWRITE" @p_11 3 7))
(step t6 (cl (= @p_3 (! (<= 1 @p_8) :named @p_9))) :rule cong :premises (t4 t5))
(step t7 (cl (! (= @p_9 @p_5) :named @p_10)) :rule hole :args ("TRUST_THEORY_REWRITE" @p_10 3 7))
(step t8 (cl (= @p_3 @p_5)) :rule trans :premises (t6 t7))
(step t9 (cl @p_7) :rule cong :premises (t8))
(step t10 (cl @p_6) :rule resolution :premises (t3 t9 a1))
(step t11 (cl) :rule resolution :premises (t2 t10))
)
