(set-option :produce-models true)
(declare-const L0 Int)
(assert (>= L0 0))
(declare-const L1 Int)
(assert (>= L1 0))
(declare-const L2 Int)
(assert (>= L2 0))
(declare-const L3 Int)
(assert (>= L3 0))
(declare-const L4 Int)
(assert (>= L4 0))
(assert (= (+ (* L0 1) (* L4 (- 1))) 0))
(assert (= (+ (* L0 (- 1)) (* L1 1)) 0))
(assert (= (+ (* L1 (- 1)) (* L2 1)) 0))
(assert (= (+ (* L2 (- 1)) (* L3 1)) 0))
(assert (> (+ (* L0 0) (* L1 0) (* L2 0) (* L3 0) (* L4 1)) 0))
(declare-const A0 Int)
(assert (>= A0 L0))
(assert (>= A0 (- L0)))
(declare-const A1 Int)
(assert (>= A1 L1))
(assert (>= A1 (- L1)))
(declare-const A2 Int)
(assert (>= A2 L2))
(assert (>= A2 (- L2)))
(declare-const A3 Int)
(assert (>= A3 L3))
(assert (>= A3 (- L3)))
(declare-const A4 Int)
(assert (>= A4 L4))
(assert (>= A4 (- L4)))
(minimize (+ A0 A1 A2 A3 A4))
(check-sat)
(get-model)
(exit)
