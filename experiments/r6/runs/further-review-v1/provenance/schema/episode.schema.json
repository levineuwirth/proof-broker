{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "R6 deterministic episode verdict v1",
  "type": "object",
  "required": ["schema_version", "task_id", "search_policy", "accepted", "search_succeeded", "certificate_type", "trust_tier", "backend", "certificate_producer", "recovery_route", "certificate_verified", "certificate_consumed", "derivation_replayed", "residual_closer", "proof_replayed", "local_obligation_closed", "whole_declaration_validated", "axiom_delta", "failure_category", "model_calls", "tokens", "model_cost_usd", "solution_sha256", "challenge_sha256", "manifest_sha256", "final_validation", "certificate_validation", "evidence_receipt_claim", "local_proof_required_reference", "resources"],
  "properties": {
    "schema_version": {"const": "r6-episode-1"},
    "task_id": {"const": "verinf-d1-70"},
    "search_policy": {"const": "cvc4_term_mode_v1"},
    "accepted": {"type": "boolean"},
    "search_succeeded": {"type": "boolean"},
    "certificate_type": {"const": "farkas"},
    "trust_tier": {"const": 1},
    "backend": {"const": "cvc4"},
    "certificate_producer": {"const": "sdk_synthesis"},
    "recovery_route": {"enum": ["bounded_enumeration", "exact_support_bounded"]},
    "certificate_verified": {"type": "boolean"},
    "certificate_consumed": {"type": "boolean"},
    "derivation_replayed": {"const": false},
    "residual_closer": {"const": "omega"},
    "proof_replayed": {"type": "boolean"},
    "local_obligation_closed": {"type": "boolean"},
    "whole_declaration_validated": {"type": "boolean"},
    "local_proof_required_reference": {"const": "ProofBroker.TermMode.farkasContradictN"},
    "resources": {"type": "object", "required": ["search", "certificate-check", "validation-local", "validation-whole"]},
    "axiom_delta": {"type": "object"},
    "failure_category": {"type": ["string", "null"]},
    "model_calls": {"const": 0},
    "tokens": {"const": 0},
    "model_cost_usd": {"const": 0},
    "solution_sha256": {"$ref": "#/$defs/hash"},
    "challenge_sha256": {"$ref": "#/$defs/hash"},
    "manifest_sha256": {"$ref": "#/$defs/hash"},
    "final_validation": {"type": "object", "required": ["local", "whole"]},
    "certificate_validation": {"type": "object", "required": ["accepted", "stage"]},
    "evidence_receipt_claim": {"type": "string"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
  "allOf": [{"if": {"properties": {"accepted": {"const": true}}}, "then": {
    "properties": {
      "search_succeeded": {"const": true}, "certificate_verified": {"const": true},
      "certificate_consumed": {"const": true}, "proof_replayed": {"const": true},
      "local_obligation_closed": {"const": true}, "whole_declaration_validated": {"const": true},
      "failure_category": {"const": null}
    }
  }}]
}
