{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "R6 credential-channel fixture proof verdict v1",
  "description": "Proof and credential-receipt binding only. Publication acceptance is decided after this record and is never a field of it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "search_policy", "task_id", "proof_accepted", "search_succeeded",
    "certificate_type", "trust_tier", "witness_proposer", "certificate_assembler", "recovery_route",
    "certificate_verified", "certificate_consumed", "derivation_replayed", "residual_closer",
    "proof_replayed", "local_obligation_closed", "whole_declaration_validated", "axiom_delta",
    "local_proof_required_reference", "accounting", "transport_validation", "solution_sha256",
    "challenge_sha256", "manifest_sha256", "prompt_sha256", "request_sha256", "response_sha256",
    "canary_nonce", "credential_receipt_sha256", "final_validation", "certificate_validation",
    "resources", "evidence_receipt_claim"
  ],
  "properties": {
    "schema_version": {"const": "r6-credential-episode-1"},
    "search_policy": {"const": "credential_http_fixture_v1"},
    "task_id": {"enum": ["verinf-d1-70", "c1-c8-2p18"]},
    "proof_accepted": {"const": true},
    "search_succeeded": {"const": true},
    "certificate_type": {"const": "farkas"},
    "trust_tier": {"const": 1},
    "witness_proposer": {"const": "canned_provider_response"},
    "certificate_assembler": {"const": "sdk_proposal_assembler_v1"},
    "recovery_route": {"const": "credential_http_fixture_v1"},
    "certificate_verified": {"const": true},
    "certificate_consumed": {"const": true},
    "derivation_replayed": {"const": false},
    "residual_closer": {"const": "omega"},
    "proof_replayed": {"const": true},
    "local_obligation_closed": {"const": true},
    "whole_declaration_validated": {"const": true},
    "local_proof_required_reference": {"const": "ProofBroker.TermMode.farkasContradictN"},
    "axiom_delta": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["added", "removed"],
        "properties": {
          "added": {"type": "array", "items": {"type": "string"}},
          "removed": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "accounting": {"type": "object"},
    "transport_validation": {"type": "object"},
    "final_validation": {"type": "object"},
    "certificate_validation": {"type": "object"},
    "resources": {"type": "object"},
    "canary_nonce": {"$ref": "#/$defs/nonce"},
    "credential_receipt_sha256": {"$ref": "#/$defs/digest"},
    "solution_sha256": {"$ref": "#/$defs/digest"},
    "challenge_sha256": {"$ref": "#/$defs/digest"},
    "manifest_sha256": {"$ref": "#/$defs/digest"},
    "prompt_sha256": {"$ref": "#/$defs/digest"},
    "request_sha256": {"$ref": "#/$defs/digest"},
    "response_sha256": {"$ref": "#/$defs/digest"},
    "evidence_receipt_claim": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonce": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
